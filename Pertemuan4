<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Analisa Proses Bisnis - Pertemuan 4</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Open+Sans:wght@400;600;700&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    /* CSS RESET & LAB THEME VARIABLES */
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --color-bg-light: #F8FAFC;
      --color-text-dark: #0F172A;
      --color-text-muted: #475569;
      --color-primary: #4338CA;   /* Indigo / Technical */
      --color-accent: #06B6D4;    /* Cyan / Digital */
      --color-orange: #EA580C;
      --color-white: #FFFFFF;
      --color-dark-bg: #0F172A;
      --navbar-height: 60px;
    }
    
    body { 
      margin: 0; 
      padding: 0; 
      background: #0B0F19; 
      font-family: 'Open Sans', sans-serif; 
      height: 100vh; 
      overflow: hidden; 
      position: relative;
    }

    /* TOP NAVIGATION BAR */
    .top-navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: var(--navbar-height);
      background: #0F172A;
      border-bottom: 2px solid #1E293B;
      color: white;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      z-index: 1000;
      font-family: 'Montserrat', sans-serif;
      box-shadow: 0 4px 14px rgba(0,0,0,0.4);
    }

    .nav-left, .nav-center, .nav-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .nav-btn {
      background: #1E293B;
      border: 1px solid #334155;
      color: white;
      font-size: 14px;
      cursor: pointer;
      padding: 8px 16px;
      border-radius: 6px;
      transition: 0.2s;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .nav-btn:hover { background: var(--color-primary); border-color: var(--color-primary); }

    /* DROPDOWN MENU SLIDES */
    .slide-selector {
      background: #1E293B;
      color: white;
      border: 1px solid #334155;
      padding: 8px 16px;
      border-radius: 6px;
      font-family: 'Montserrat', sans-serif;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      outline: none;
      max-width: 360px;
    }
    .slide-selector option { background: #0F172A; }

    /* MAIN CONTAINER ADJUSTMENT */
    #presentation-area {
      position: absolute;
      top: var(--navbar-height);
      left: 0;
      right: 0;
      bottom: 0; 
      overflow: hidden;
    }

    /* HARD LOCK 16:9 CONTAINER (1280x720px) */
    .slide-container {
      width: 1280px !important;
      height: 720px !important;
      background: var(--color-bg-light);
      color: var(--color-text-dark);
      display: flex;
      flex-direction: column;
      box-shadow: 0 10px 40px rgba(0,0,0,0.6);
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(1);
      transform-origin: center center;
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.35s ease-in-out;
      pointer-events: none;
    }

    .slide-container.active {
      visibility: visible;
      opacity: 1;
      z-index: 5;
      pointer-events: auto;
    }

    /* TYPOGRAPHY */
    h1, h2, h3, h4, .eyebrow { font-family: 'Montserrat', sans-serif; }
    h1 { font-size: 60px; font-weight: 800; line-height: 1.15; margin-bottom: 20px; color: var(--color-text-dark); }
    h2 { font-size: 42px; font-weight: 700; line-height: 1.25; margin-bottom: 24px; color: var(--color-text-dark); }
    h3 { font-size: 30px; font-weight: 700; margin-bottom: 14px; color: var(--color-primary); }
    p, li { font-size: 24px; line-height: 1.5; color: var(--color-text-muted); }
    .eyebrow { font-size: 18px; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 12px; }
    .divider { width: 80px; height: 6px; background: var(--color-accent); margin: 20px 0 24px 0; }
    
    .bg-dark { background: var(--color-dark-bg) !important; color: var(--color-white) !important; }
    .bg-dark h1, .bg-dark h2, .bg-dark h3, .bg-dark p, .bg-dark li { color: var(--color-white) !important; }
    
    /* LAYOUT: SPLIT SCREEN */
    .layout-split { display: flex; flex-direction: row; flex: 1 1 100%; width: 100%; height: 100%; }
    .split-col { display: flex; flex-direction: column; justify-content: center; height: 100%; padding: 40px 80px; }
    .split-img-col { padding: 0 !important; margin: 0 !important; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #0F172A; }
    .split-img-col img { width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; padding: 0; }
    
    /* SPLIT RATIOS */
    .w-40 { flex: 0 0 40%; width: 40%; }
    .w-50 { flex: 0 0 50%; width: 50%; }
    .w-60 { flex: 0 0 60%; width: 60%; }

    /* LAYOUT: STANDARD / CENTERED */
    .pad-standard { padding: 40px 80px; display: flex; flex-direction: column; flex: 1; height: 100%; }
    .center-content { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; flex: 1; height: 100%; padding: 40px 80px; }
    .flex-grow-center { flex-grow: 1; display: flex; flex-direction: column; justify-content: center; }

    /* COMPONENTS: LISTS & CARDS */
    .minimal-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 20px; }
    .minimal-list li { display: flex; align-items: flex-start; gap: 20px; font-weight: 600; }
    .minimal-list li i { font-size: 32px; color: var(--color-primary); width: 40px; text-align: center; margin-top: 4px; }

    .card-grid { display: flex; gap: 24px; align-items: stretch; width: 100%; justify-content: center; flex-wrap: wrap; }
    .card { background: var(--color-white); border-radius: 16px; padding: 32px 32px; flex: 1 1 0; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid #E2E8F0; display: flex; flex-direction: column; align-items: flex-start; }
    .card i { font-size: 48px; color: var(--color-accent); margin-bottom: 16px; }

    /* DIAGRAM POOL & LANE PREVIEW */
    .pool-preview { width: 100%; border: 3px solid #334155; border-radius: 8px; display: flex; overflow: hidden; background: white; margin-top: 20px; }
    .pool-header { width: 60px; background: #334155; color: white; display: flex; align-items: center; justify-content: center; writing-mode: vertical-rl; transform: rotate(180deg); font-weight: 800; font-size: 18px; letter-spacing: 2px; }
    .lanes-container { flex: 1; display: flex; flex-direction: column; }
    .lane-box { display: flex; border-bottom: 2px dashed #CBD5E1; min-height: 100px; }
    .lane-box:last-child { border-bottom: none; }
    .lane-title { width: 140px; background: #F1F5F9; border-right: 2px solid #CBD5E1; font-weight: 700; color: #475569; display: flex; align-items: center; justify-content: center; padding: 12px; font-size: 16px; text-align: center; }
    .lane-content { flex: 1; padding: 16px; display: flex; align-items: center; gap: 16px; }

    /* BPMN ARTIFACT SHAPES */
    .artifact-doc { width: 80px; height: 100px; border: 2px solid #4338CA; background: #EEF2FF; border-radius: 4px 16px 4px 4px; display: flex; align-items: center; justify-content: center; font-size: 32px; color: #4338CA; position: relative; }
    .artifact-store { width: 90px; height: 90px; border-radius: 12px; border: 3px solid #06B6D4; background: #ECFEFF; display: flex; align-items: center; justify-content: center; font-size: 36px; color: #06B6D4; }
    .artifact-note { border-left: 4px solid #64748B; background: #F8FAFC; padding: 12px 18px; font-style: italic; font-size: 18px; border-radius: 0 8px 8px 0; color: #334155; }

    /* INTERACTIVE: DRAG AND DROP */
    .draggable-container { display: flex; gap: 16px; margin-bottom: 16px; justify-content: center; min-height: 60px; flex-wrap: wrap; }
    .drag-item { 
      cursor: grab; padding: 10px 20px; font-size: 18px; background: white; 
      border: 3px solid #4338CA; border-radius: 12px; font-weight: 700; 
      user-select: none; color: #0F172A; text-align: center; margin-bottom: 8px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: 0.2s; display: inline-block;
    }
    .drag-item:active { cursor: grabbing; transform: scale(0.95); }
    .drag-item.dragging { opacity: 0.5; }
    
    .dropzones-container { display: flex; gap: 24px; justify-content: center; align-items: stretch; width: 100%; }
    .drop-zone { 
      border: 4px dashed #CBD5E1; border-radius: 16px; flex: 1; 
      min-height: 180px; padding: 16px; display: flex; flex-direction: column; 
      align-items: center; background: #FFFFFF; transition: 0.3s;
    }
    .drop-zone h3 { font-size: 22px; margin-bottom: 12px; color: #475569; border-bottom: 2px solid #CBD5E1; padding-bottom: 8px; width: 100%; text-align: center;}
    .drop-zone.drag-over { border-color: var(--color-primary); background: #EEF2FF; }
    .drop-content { flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; width: 100%; gap: 8px; }

    /* INTERACTIVE: QUIZ */
    .quiz-option {
      background: #F8FAFC; border: 2px solid #CBD5E1; padding: 12px 20px; 
      border-radius: 12px; font-size: 20px; font-weight: 600; cursor: pointer; 
      text-align: left; transition: 0.2s; margin-bottom: 12px; width: 100%;
      color: #334155; display: flex; align-items: center; gap: 16px;
    }
    .quiz-option:hover { background: #E2E8F0; transform: translateX(8px); }
    .quiz-option.correct { background: #D1FAE5; border-color: #10B981; color: #065F46; }
    .quiz-option.wrong { background: #FEE2E2; border-color: #EF4444; color: #991B1B; }
    
    .quiz-feedback { 
      display: none; margin-top: 16px; padding: 16px 24px; background: #F0F9FF; 
      border-left: 8px solid var(--color-primary); border-radius: 0 12px 12px 0; font-size: 18px; 
      animation: fadeIn 0.4s ease-in-out;
    }
    .quiz-feedback.show { display: block; }
    .quiz-feedback h4 { font-size: 22px; margin-bottom: 8px; color: var(--color-primary); }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
